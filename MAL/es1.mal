// ISET 32 bit-mask 


// L' istruzione iset utilizza una maschera di 32 bit che segue il codice operativo e applica la maschera all'elemento che si trova 
// in cima allo stack, forzando ad 1 i bit che sono 1 nella mask e lasciando inalterati gli altri 

// ricordiamo sempre che arriviamo da una Main1
// quindi, Main, pc = pc +1; fetch; goto  (mbr) --> in questo caso stiamo leggendo l'opcode e poi chiediamo la lettura del primo byte 
// di operando


// iset1 pc = pc +1; fetch  //legge il secondo byte di mask

// iset2 h = mbru << 8  // trasla il primo byte in H di un byte (a destra)

// iset 3 pc = pc +1; fetch //legge il terzo byte

// iset4 h = h or mbru << 8 //forma la maschera con il primo e il secondo byte (traslato di 8 da destra)

// iset5 pc = pc  + 1; fetch //lettura del quarto byte

// iset6 h = h or mbru << 8  // forma la maschera formata dal primo, secondo e terzo byte

//iset7 h = h or mbru  //completamento della maschera

//iset8 pc = pc  +1; fetch  //fetch della prox microistruzione (ovvero, prossimo opcode), ci serve per preparare il ritorno alla Main1

//iset9 mdr = tos= tos or h // OR tra mask e cima stack, aggiorna tos e prepara la scrittura in cima stack

// iset10 mar = sp; wr; goto (Main1) //sovrascrive il nuovo valore della cima in mdr nello stack pointer, ritorna al Main1
// con il precedente fetch in memoria abbiamo passato in MBR il valore della prossima microistruzione

// Esercizio 2
// IMUL, sostiuisce il contenuto delle ultime due parole in cima allo (di valore positivo o nullo) con il loro prodotto.

// imul1 mar = sp = sp - 1; rd
//pop del valore in cima allo stack e read del valore sottostante
// il valore in cima allo stack si trova nel registro TOS (quindi non perdiamo il valore del secondo operando)

// imul2 h=0 
// registro temporaneo, lo utilizzo per i calcoli

// imul3 mdr=mdr-1; if (N) goto imul5; else goto imul4
//valore della read precedente, decremento e verifico se mdr < 0

// imul4 h=h+tos; goto imul3

// eseguo la moltiplicazione, (2 * a) = a + a
// (3 * a) = (a + a + a)
// e poi ritorno alla riga imul3 per verificare la condizione di mdr e quindi il contatore

// imul5 tos =mdr;  wr; goto Main1
// ritorno alla riga 5 e quindi sovrascrivo con la nuova cima dello stack il valore di mdr e scrivo in memoria centrale il valore trovato
//ritorno alla Main1 (per lettura prossima microistruzione)


