// idiv4 mdr = mdr - h; if (N) goto idiv6; else goto idiv5 //dividendo - divisore e verifichiamo se la sottrazione è negativa 
// idiv5 opc = opc  +1; goto idiv4 
// idiv6  tos = mdr = opc; wr; goto Main1


// uscite di N, Z dell' ALU: 

// N (valore < 0)
// Z (valore == 0)

//esempio : 
// cima = 3, sotto-cima = 8
// 8-3 = 5, opc =0+1
// 5-3 = 2, opc = 1 + 1 = 2
// 2-3 = -1, allora ritorno il valore di divisione intera = 2 in mdr tos all'indirizzo della cima dello stack


// Esercizio 4

// IMOD, che sostituisce il contenuto delle ultime due parole in cima allo stack, (di cui penultimo di valore positivo o null
// e l'ultimo strettamente positivo) con il resto della loro divisione.

// 27 MOD 6 = 3 

// imod1 mar=sp = sp -1; rd
// imod2 h=tos
// imod3 mdr = mdr - h; if (N) goto imod4; else goto imod3
// imod4 tos = mdr = mdr + h; wr; goto Main1 

// esempio:
//
// cima = 3(divisore), sotto-cima = 8(dividendo)
// 8-3 = 5;
// 5-3 = 2;
// 2-3 = -1; (valore negativo)
// -1 + 3 (divisore) = 2 (ovvero il suo resto)

