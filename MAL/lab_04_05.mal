// di valore positivo o nullo e ultimo strettamente positivo), con il risultato della loro divisione intera.

// idiv1 mar = sp = sp-1; rd  //dividendo
// idiv2 h= tos 
// idiv3 opc=0  // utilizziamo questo registro come contatore 
// idiv4 mdr = mdr - h; if (N) goto idiv6; else goto idiv5 //dividendo - divisore e verifichiamo se la sottrazione è negativa 
// idiv5 opc = opc  +1; goto idiv4 
// idiv6  tos = mdr = opc; wr; goto Main1


// uscite di N, Z dell' ALU: 

// N (valore < 0)
// Z (valore == 0)

