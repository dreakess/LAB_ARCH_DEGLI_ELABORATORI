.constant
      objref 0xcafe
.end-constant
.main
.var
result
.end-var
      LDC_W objref
      BIPUSH 4
      BIPUSH 9
      BIPUSH 12
      INVOKEVIRTUAL F
      ISTORE result
      HALT
.end-main
.method F(x,y,z)
.var
sommaxy
.end-var
      ILOAD x
      ILOAD y
      IADD
      ISTORE sommaxy
      ILOAD z
      ILOAD sommaxy
      IF_ICMPEQ restituisci1
      BIPUSH 0
      GOTO return
restituisci1: BIPUSH 1
return: IRETURN
.end-method
